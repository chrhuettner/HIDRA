public static class LogMessageEncoder extends ch.qos.logback.core.encoder.LayoutWrappingEncoder<LogMessage> {

    private TTransport framedTransport;
    private TProtocol protocol;
    private OutputStream os;

public void init(OutputStream os) {

      this.os = os;
      // Use the TFlushingFastFramedTransport to be compatible with singer_thrift
      // log.
      final int bufferCapacity = 10;
      framedTransport = new TFastFramedTransport(new TIOStreamTransport(os),
          bufferCapacity);
      protocol = new TBinaryProtocol(framedTransport);
    }

@Override public byte[] encode(LogMessage logMessage) {

      try {
        logMessage.write(protocol);
        framedTransport.flush();
      } catch (TException e) {
        throw new IOException(e);
      }
    }

public void close() throws java.io.IOException {

      framedTransport.close();
    }
  }

