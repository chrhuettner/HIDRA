    }

    private List<Object> toList(Xpp3Dom node, String childName) {
      List<Object> list = new ArrayList<>();

      int n = node.getChildCount();
      for (int i = 0; i < n; i++) {
        Xpp3Dom child = node.getChild(i);

        if (!childName.equals(child.getName())) {
